# Copy to .env at the workspace root. Never commit real credentials.
# Existing environment variables take precedence over .env.
VOICEBOX_URL=http://127.0.0.1:17493
VOICEBOX_PROFILE=
VOICEBOX_ENGINE=qwen
VOICEBOX_MODEL_SIZE=0.6B
# Optional Apple Silicon fast path; default "voicebox" preserves the HTTP adapter.
# The mlx extra and a complete existing local snapshot are required.
VOICEBOX_TTS_BACKEND=voicebox
VOICEBOX_MLX_MODEL_PATH=
# Optional private imported reference folder: fast mode then needs no Voicebox server.
VOICEBOX_VOICE_BUNDLE=
# Fast mode conditions the voice at Start session; no warm-up audio is played or saved.
VOICEBOX_MLX_PREWARM=1
# Change only after stopping desktop generation and other Voicebox consumers.
VOICEBOX_EXCLUSIVE=0
# Optional shared lock/uncertain-state directory (default: ~/.local/state/livekit-voicebox).
# Use the same directory for every local Studio checkout talking to this backend.
# VOICEBOX_RUNTIME_DIR=
# "azure" uses existing resources through your signed-in Azure CLI.
VOICEBOX_AI_PROVIDER=openai
# Studio Settings can select these independently; saved library settings take precedence.
VOICEBOX_STT_PROVIDER=nemotron
VOICEBOX_LLM_PROVIDER=hermes
VOICEBOX_LLM_MODEL=gpt-5.6-luna
VOICEBOX_REASONING_EFFORT=low
# Recommended reasoning path. The API key remains in the Studio/worker process.
# Set VOICEBOX_LLM_PROVIDER=hermes after the server advertises runs, SSE events,
# status, approval-response, and stop capabilities.
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_SERVER_KEY=
HERMES_PROFILE=default
# Provision only the public CPU ASR model/runtime explicitly, never on page load.
NEMOTRON_URL=http://127.0.0.1:8766
NEMOTRON_SERVER_BINARY=
NEMOTRON_MODEL_PATH=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=

# Only needed for VOICEBOX_AI_PROVIDER=azure. Install the azure extra as well.
# These are resource identifiers, not credentials. Do not paste Azure keys here.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_OPENAI_ACCOUNT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL=gpt-4.1-nano
OPENAI_API_VERSION=2024-10-21
AZURE_SPEECH_ACCOUNT=
AZURE_SPEECH_REGION=

# Disable optional SDK text tracing/audio dumps for the local setup.
OTEL_SDK_DISABLED=true
LK_DUMP_TTS=0

# Live Hermes vertical-slice test (paid/external use; never enabled by default).
# It also requires every LiveKit/Hermes/model variable above, an authorized local
# voice bundle, and a short authorized synthetic English recording. Do not put
# credentials or private recordings in source control.
HERMES_STUDIO_LIVE=0
HERMES_STUDIO_TEST_AUDIO=
HERMES_STUDIO_AUDIO_EXPECT=
HERMES_STUDIO_MEASURED_TURNS=20
